;;; Triangle.mon --- the first Vulkan program

import Graphics
import Graphics.Vulkan
import Shaders.TriangleFrag
import Shaders.TriangleVert

module Main


init-window 960 540 "Monad — Vulkan Triangle"
load-shader
  &triangle-vertex-shader   (count triangle-vertex-shader)
  &triangle-fragment-shader (count triangle-fragment-shader)

until window-should-close?
  begin-drawing
  draw-triangle
  end-drawing

close-window
