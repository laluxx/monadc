:TEST-ID        tests.embedding.surface.beginner-host
:TEST-CONTEXT   dec.embedding.progressive-surface-api
:TEST-PURPOSE   Keep the first embedding program understandable in one screen.
:TEST-ATOM      atom.embedding.32.surface.one-owner-host
:TEST-EXPECT    open, bind, direct call, and close without internal machinery
:TEST-MENU-PATH embedding/branches/surface/atom.embedding.32.surface.one-owner-host

#+begin_src c
Embedding Monad: the smallest complete host
============================================

Build after `sudo make install`:

  gcc Embedding.c -lmonad-embed -pthread -o Embedding
*/
#if defined(__has_include) && !__has_include(<monad/monad.h>)
#  include "../embed/include/monad/monad.h"
#else
#  include <monad/monad.h>
#endif

#include <stdio.h>
#include <stdlib.h>

static int64_t double_number(int64_t number) {
    return number * 2;
}

static void check(monad_status_t status, const monad_error_t *error) {
    if (status == MONAD_OK) return;
    fprintf(stderr, "Monad: %s\n",
            error && error->message ? error->message : monad_status_name(status));
    exit(EXIT_FAILURE);
}

int main(void) {
    monad_t *monad = NULL;
    monad_error_t error = {0};
    monad_i64_function_t double_from_monad = NULL;

    check(monad_open(&monad, &error), &error);
    check(monad_define_i64_function(
        monad, "double", double_number, "Double an integer.", &error), &error);
    check(monad_find_i64_function(
        monad, "double", &double_from_monad, &error), &error);

    printf("double(21) = %lld\n", (long long)double_from_monad(21));
    check(monad_close(monad, &error), &error);
    return 0;
}
#+end_src
