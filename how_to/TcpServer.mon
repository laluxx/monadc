;;; TcpServer.mon --- a durable sequential TCP server

:author "Laluxx"
:version "0.1.0"
:keywords "how-to network tcp server io"

;;; Commentary:

 A server has three visible moments: listen, accept, and serve. This one stays
 alive across clients and isolates connection failures. Socket layout, retry
 policy, complete writes, and operating-system calls belong to Network.Socket.

;;; Code:

import Network.Socket


define server-port :: Int
  39127


define serve-client :: Socket -io-> Int
  :doc "Echo one client stream and always close its socket."
  client ->
    def status (echo-stream client)
    def closed (close-socket client)
    status


define continue-server? :: Socket -> SocketResult -io-> Bool
  :doc "Serve an accepted client or close a failed listener."
  listener [SocketFailure status] ->
    def closed (close-socket listener)
    False
  listener [SocketReady client] ->
    def served (serve-client client)
    True


define serve-clients :: Socket -io-> Int
  :doc "Accept sequential clients for the lifetime of LISTENER."
  listener ->
    def running True
    while running (set! running (continue-server? listener (accept-client listener)))
    0


define run-server :: SocketResult -io-> Int
  :doc "Run a persistent server when listener setup succeeds."
  [SocketFailure status] -> status
  [SocketReady listener] -> serve-clients listener


define main :: Int -io-> Int
  :doc "Run the loopback TCP server until it is stopped."
  _ -> run-server (listen-loopback server-port)


main 0
