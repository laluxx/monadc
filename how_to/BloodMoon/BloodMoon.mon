;;; BloodMoon.mon --- scene-facing Blood Moon resources

import Graphics
import Graphics.Vulkan
import Shaders

module BloodMoon
  [load-blood-fragment-shader]


define load-blood-fragment-shader :: VkDevice -io-> VulkanShader
  :doc "Create the procedural Blood Moon fragment shader on DEVICE."
  device -> create-shader-module device &blood-fragment-shader (count blood-fragment-shader)
