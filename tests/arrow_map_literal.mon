:TEST-ID tests.reader.collections.arrow-map-literal
:TEST-CONTEXT monadc.context.wisp.sugar.arrow-value-binding
:TEST-PURPOSE Arrow-valued map literals retain compact and hanging layout forms.
:TEST-EXPECT parse-json
:TEST-TIER regression
:TEST-STATUS active
:TEST-SECTION reader
:TEST-CATEGORY collections

define compact
{ :a -> 1
  :b -> 2 }

define hanging
 { :a -> 1
   :b -> 2 }

define expanded
  {
    :a -> 1
    :b -> 2
  }

show Map? compact
show Map? hanging
show Map? expanded
show (count compact) + (count hanging) + (count expanded)
