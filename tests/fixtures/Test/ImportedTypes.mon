;;; ImportedTypes.mon --- Cross-module nominal ABI regression provider

module Test.ImportedTypes
  [Pair PairValue pair-total
   Outcome Rejected Accepted]


layout Pair
  [left  :: Int]
  [right :: Int]


data Outcome a
  = Rejected String
  | Accepted a


define PairValue :: Pair
  (Pair :left 20 :right 22)


define pair-total :: Pair -> Int
  pair -> pair.left + pair.right
