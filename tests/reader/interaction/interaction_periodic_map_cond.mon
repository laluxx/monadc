:TEST-ID tests.interaction.interaction_periodic_map_cond
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Periodic decimals in a map and cond lookup parse together.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-STATUS unregistered-baseline-2026-06-15

(module Main)
(define ratios #{:third 0.(3) :sixth 0.1(6)})
(cond [(Map? ratios) (find ratios :third)] [else 0])
