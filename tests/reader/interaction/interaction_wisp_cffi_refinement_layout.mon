:TEST-ID tests.interaction.interaction_wisp_cffi_refinement_layout
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Wisp C include, refinement, layout, constructor, and field access parse together.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-STATUS unregistered-baseline-2026-06-15

module Main
include "math.h"
type Positive { n ∈ Int | (> n 0) }
layout Point
  [x :: Positive]
  [y :: Positive]
define p Point 3 4
show p.x
