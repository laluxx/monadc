:TEST-ID tests.interaction.interaction_layout_method_where_method
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Layout where method desugars into a qualified method definition beside constructor use.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-EXPECT-DESUGAR (module Main)\n(layout Color [r :: U8] [g :: U8] [b :: U8])\n(define Color.fromRGB (lambda ([r :: U8] [g :: U8] [b :: U8] -> Color) (Color r g b)))\n(define red (Color 255 0 0))
:TEST-STATUS unregistered-baseline-2026-06-15

module Main
layout Color
  [r :: U8]
  [g :: U8]
  [b :: U8]
  where
    method fromRGB :: U8 -> U8 -> U8 -> Color
      r g b -> (Color r g b)

define red Color 255 0 0
