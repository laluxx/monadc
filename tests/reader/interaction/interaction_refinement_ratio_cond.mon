:TEST-ID tests.interaction.interaction_refinement_ratio_cond
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Refinement predicate with ratio and cond over ratio value parse together.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-STATUS unregistered-baseline-2026-06-15

(module Main)
(type Majority { r ∈ Ratio | (> r 1/2) })
(define [r :: Majority] 75%)
(cond [(> r 50%) "yes"] [else "no"])
