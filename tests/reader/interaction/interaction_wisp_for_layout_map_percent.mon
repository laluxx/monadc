:TEST-ID tests.interaction.interaction_wisp_for_layout_map_percent
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Wisp for loop combines layout constructor, map literal, and percentage value.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-STATUS unregistered-baseline-2026-06-15

module Main

layout Tax
  [rate :: Ratio]
for t -> [(Tax 22%) (Tax 10%)]
  show #{:rate t.rate}
