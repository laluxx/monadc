:TEST-ID tests.interaction.interaction_data_refinement_match_ratio
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Data, refinement annotation, ratio value, and match parse together.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-STATUS unregistered-baseline-2026-06-15

(module Main)
(data Rate | Rate Ratio | Missing)
(type PositiveRatio { r ∈ Ratio | (> r 0%) })
(define [r :: PositiveRatio] 22%)
(match (Rate r) with (Rate x) -> x _ -> 0%)
