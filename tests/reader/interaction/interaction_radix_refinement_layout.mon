:TEST-ID tests.interaction.interaction_radix_refinement_layout
:TEST-CONTEXT monadc.context.language.feature-interactions
:TEST-PURPOSE Radix predicate and layout value parse together.
:TEST-EXPECT parse-json
:TEST-MENU interaction
:TEST-MENU-PATH reader/interaction
:TEST-CLI-TARGET reader interaction
:TEST-TIER future
:TEST-STATUS unregistered-baseline-2026-06-15

(module Main)
(type Byteish { n ∈ Int | (and (>= n 2r0) (<= n 16rFF)) })
(layout Packet [tag :: Byteish] [payload :: Arr])
(define p (Packet 16r2A [1 2 3]))
