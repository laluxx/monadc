:TEST-ID tests.superset.map_cond_count
:TEST-CONTEXT monadc.context.language.atom-supersets
:TEST-PURPOSE Map count combines with cond clauses.
:TEST-EXPECT parse-json
:TEST-MENU superset
:TEST-MENU-PATH reader/superset
:TEST-CLI-TARGET reader superset
:TEST-TIER regression
:TEST-SUPERSET map-count,cond
:TEST-STATUS passing-baseline-2026-06-15

(module Main)
(define cfg #{:a 1})
(cond [(> (count cfg) 0) "nonempty"] [else "empty"])
