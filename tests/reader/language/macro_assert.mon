:TEST-ID tests.language.macro_assert
:TEST-CONTEXT monadc.context.language.syntax-corpus
:TEST-PURPOSE Assert macro with rest body parses.
:TEST-EXPECT parse-json
:TEST-MENU language
:TEST-MENU-PATH reader/language
:TEST-CLI-TARGET reader language
:TEST-TIER future
:TEST-EXPECT-JSON-TABLE src/testing/data/reader-atoms.golden.jsonl
:TEST-EXPECT-JSON-KEY macro_assert
:TEST-STATUS unregistered-baseline-2026-06-15

(define (assert [condition : Bool] . [body : Syntax] -> Syntax) (when condition (begin . body)))
