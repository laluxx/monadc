:TEST-ID tests.reader.module.grouped-layout-exports
:TEST-CONTEXT monadc.context.module.codegen-import-resolution
:TEST-PURPOSE Grouped module export sections preserve layout types and constructors.
:TEST-EXPECT parse-json
:TEST-TIER regression
:TEST-SECTION reader
:TEST-CATEGORY modules

module Test.GroupedLayoutExports where

  :types
    GroupedPoint

  :construction
    origin

layout GroupedPoint
  x :: Int
  y :: Int

define origin :: GroupedPoint
  GroupedPoint 0 0

tests
  assert-eq origin.x 0 "grouped modules retain nominal layout fields"
  assert-eq origin.y 0 "grouped modules retain nominal layout construction"
