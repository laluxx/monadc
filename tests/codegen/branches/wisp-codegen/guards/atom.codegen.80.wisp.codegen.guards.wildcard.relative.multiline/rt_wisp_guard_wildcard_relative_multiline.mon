module Main

define buffer :: [8]

define step-or-zero :: Int -> Float -> Int -> Int
  _ _ value | >= 3 -> 0
  first second value ->
    def next (value + 1)
    def result (next + (first - first) + (Int (second - second)))
    result

define fill-until-three :: Int -> Float -> Int -> Int
  _ _ index | >= 3 -> 0
  first second index ->
    def status (set! (buffer index) (index + 10))
    def next (fill-until-three first second (index + 1))
    next + (status - status)

show (step-or-zero 9 1.5 0)
show (step-or-zero 9 1.5 3)
show (fill-until-three 9 1.5 0)
show (buffer 0)
show (buffer 2)
