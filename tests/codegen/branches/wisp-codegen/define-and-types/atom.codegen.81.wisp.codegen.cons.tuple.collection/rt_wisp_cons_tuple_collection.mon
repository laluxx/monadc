:TEST-ID tests.codegen.rt-wisp-cons-tuple-collection
:TEST-CONTEXT monadc.context.wisp
:TEST-PURPOSE Wisp cons preserves tuple elements in collection results.
:TEST-EXPECT compile, run
:TEST-TIER regression

module Main

define pairWith :: [Int] -> [Int] -> [(Int, Int)]
  [] _ -> []
  _ [] -> []
  [x|xs] [y|ys] -> [(x, y) | pairWith xs ys]

show (pairWith [1 2] [3 4])
