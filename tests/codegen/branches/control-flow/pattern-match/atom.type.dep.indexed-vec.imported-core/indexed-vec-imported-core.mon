(module Main)

import Data.Nat
import Data.Vec
import Data.Functor

define imported-head :: Vec (S n) t -> t
  [. x _] -> x

define imported-tail :: Vec (S n) t -> Vec n t
  [. _ xs] -> xs

define imported-method-head :: Vec (S n) t -> t
  value -> value.head

define imported-method-tail :: Vec (S n) t -> Vec n t
  value -> value.tail

define imported-method-map :: Vec n a -> (a -> b) -> Vec n b
  values f -> Vec.map f values

define imported-functor-map :: Vec n a -> (a -> b) -> Vec n b
  values f -> map f values
