(module Main)
data NatI :: Type
  ZI : NatI
  SI : NatI -> NatI
data VectI :: NatI -> Type -> Type
  NilI  : VectI ZI t
  ConsI : t -> VectI n t -> VectI (SI n) t
(define (firstI [value : (VectI (SI n) t)] -> t)
  [ConsI x _] -> x)
(define (tailI [value : (VectI (SI n) t)] -> (VectI n t))
  [ConsI _ xs] -> xs)
