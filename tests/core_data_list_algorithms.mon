:TEST-ID tests.core.data-list.algorithms
:TEST-CONTEXT monadc.context.core-libs.data-list
:TEST-PURPOSE Core owns total, stable, polymorphic finite-list algorithms.
:TEST-ATOM Import Data.List and exercise its public API across element types.
:TEST-EXPECT parse-json
:TEST-TIER regression
:TEST-MENU core
:TEST-MENU-PATH core/data/list

import Data.List
import Data.Tuple
module Core.DataListAlgorithms []


tests
  assert-eq
    (show (fst (partition (list 1 2 3 4 5) (lambda (value) (= (% value 2) 0)))))
    "(2 4)"
    "Data.List partition preserves matching order across module boundaries"

  assert-eq
    (show (intercalate (list 0) (list (list 1 2) (list 3) (list 4 5))))
    "(1 2 0 3 0 4 5)"
    "Data.List intercalate joins nested finite lists across modules"

  assert-eq
    (show (chunks-of 3 (list "a" "b" "c" "d" "e")))
    "((a b c) (d e))"
    "Data.List chunks-of remains polymorphic across module boundaries"

  assert-eq
    (show (replace-at 1 "new" (list "left" "old" "right")))
    "(left new right)"
    "Data.List replace-at updates one position across module boundaries"
