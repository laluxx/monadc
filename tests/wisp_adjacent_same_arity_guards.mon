:TEST-ID tests.reader.wisp.adjacent-same-arity-guards
:TEST-CONTEXT monadc.context.wisp
:TEST-PURPOSE A guarded definition must stop before a following definition with the same arity.
:TEST-EXPECT compile, run, two assertions pass
:TEST-TIER regression
:TEST-SECTION reader
:TEST-CATEGORY wisp

module Test.WispAdjacentSameArityGuards []


define first-scan :: Int -> Int -> [Int] -> Int
  left right [] -> left
  left right [item|rest]
    | item = 0  -> right
    | otherwise -> left


define second-scan :: Int -> Int -> [Int] -> Int
  left right [] -> right
  left right [item|rest]
    | item = 1  -> left
    | otherwise -> right


tests
  assert-eq (first-scan 3 7 ⌜0⌝) 7 "First guarded matcher remains independent"
  assert-eq (second-scan 3 7 ⌜1⌝) 3 "Following same-arity definition remains independent"
