;;; Term.mon --- POSIX terminal and termios bindings

:author   Laluxx
:version  0.9.0
:platform "linux-x86_64"
:keywords system posix terminal termios ioctl

;;; Commentary:

 This is the Linux x86-64 terminal ABI backend; ioctl numbers and termios
 layout constants are platform implementation details, not portable policy.

 Canonical home: System.Posix.Term. This module is platform-specific and is
 intentionally not part of the pure prelude.

 TCGETS/TCSETS use the Linux UAPI =struct termios=, not libc's potentially
 different structure: four 32-bit flag words followed by one line-discipline
 byte and nineteen control bytes. WinSize is four 16-bit unsigned fields. These
 widths are part of the ABI contract; widening either structure to ordinary Int
 fields corrupts field interpretation even if the backing allocation happens to
 be large enough.

 Query operations expose checked =*-result= forms. Historical value-returning
 wrappers remain for compatibility but fail loudly when ioctl fails rather than
 returning a zero-filled structure that is indistinguishable from valid kernel
 state. ioctl operations whose third argument is an integer value use a distinct
 syscall wrapper from pointer-valued requests; Linux does not reinterpret a
 pointer to an integer as the integer argument itself.

;;; Code:

import Data.Either

module System.Posix.Term where

  :types
    Termios WinSize

  :abi
    termios-abi-version

  :ioctl-requests
    TCGETS TCSETS TCSETSW TCSETSF TCGETA TCSETA TCSETAW TCSETAF
    TCSBRK TCXONC TCFLSH TIOCEXCL TIOCNXCL TIOCSCTTY TIOCGPGRP TIOCSPGRP
    TIOCOUTQ TIOCSTI TIOCGWINSZ TIOCSWINSZ TIOCMGET TIOCMBIS TIOCMBIC
    TIOCMSET TIOCGSOFTCAR TIOCSSOFTCAR TIOCLINUX TIOCCONS TIOCGSERIAL
    TIOCSSERIAL TIOCPKT TIOCNOTTY TIOCSETD TIOCGETD TCSBRKP TIOCSBRK
    TIOCCBRK TIOCGSID

  :input-flags
    IGNBRK BRKINT IGNPAR PARMRK INPCK ISTRIP INLCR IGNCR ICRNL IXON
    IXOFF IXANY IMAXBEL IUTF8

  :output-flags
    OPOST ONLCR OCRNL ONOCR ONLRET OFILL OFDEL NLDLY CRDLY TABDLY BSDLY
    VTDLY FFDLY

  :control-flags
    CSIZE CS5 CS6 CS7 CS8 CSTOPB CREAD PARENB PARODD HUPCL CLOCAL

  :baud-rates
    B0 B50 B75 B110 B134 B150 B200 B300 B600 B1200 B1800 B2400 B4800
    B9600 B19200 B38400 B57600 B115200 B230400

  :local-flags
    ISIG ICANON XCASE ECHO ECHOE ECHOK ECHONL NOFLSH TOSTOP ECHOCTL
    ECHOPRT ECHOKE FLUSHO PENDIN IEXTEN

  :control-characters
    VEOF VEOL VERASE VINTR VKILL VMIN VQUIT VSTART VSTOP VSUSP VTIME

  :modem-bits
    TIOCM_LE TIOCM_DTR TIOCM_RTS TIOCM_ST TIOCM_SR TIOCM_CTS TIOCM_CAR
    TIOCM_RNG TIOCM_DSR TIOCM_CD TIOCM_RI

  :standard-streams
    STDIN STDOUT STDERR

  :masks
    term-or3 term-or4 term-or5 term-or8
    raw-iflag-mask raw-lflag-mask cbreak-lflag-mask

  :primitives
    sys-read sys-write sys-ioctl sys-ioctl-value

  :attributes
    tty-get-attr-result tty-get-attr tty-set-attr tty-set-attr-drain tty-set-attr-flush
    tty-raw-termios tty-cbreak-termios
    tty-raw-mode-result tty-raw-mode tty-cbreak-mode-result tty-cbreak-mode

  :window-and-flow
    get-winsize-result get-winsize set-winsize tty-flush tty-flow tty-send-break

  :modem
    tty-get-modem-result tty-get-modem tty-set-modem tty-set-modem-bits tty-clear-modem-bits

  :process-control
    tty-get-pgrp-result tty-get-pgrp tty-set-pgrp tty-get-sid-result tty-get-sid
    tty-make-controlling tty-release-controlling

  :io
    read-char write-char write-str read-buf


define termios-abi-version :: Int 2


layout Termios
  c_iflag :: U32
  c_oflag :: U32
  c_cflag :: U32
  c_lflag :: U32
  c_line  :: U8
  c_cc0   :: U8
  c_cc1   :: U8
  c_cc2   :: U8
  c_cc3   :: U8
  c_cc4   :: U8
  c_cc5   :: U8
  c_cc6   :: U8
  c_cc7   :: U8
  c_cc8   :: U8
  c_cc9   :: U8
  c_cc10  :: U8
  c_cc11  :: U8
  c_cc12  :: U8
  c_cc13  :: U8
  c_cc14  :: U8
  c_cc15  :: U8
  c_cc16  :: U8
  c_cc17  :: U8
  c_cc18  :: U8


layout WinSize
  ws_row    :: U16
  ws_col    :: U16
  ws_xpixel :: U16
  ws_ypixel :: U16


define TCGETS      0x5401
define TCSETS      0x5402
define TCSETSW     0x5403
define TCSETSF     0x5404
define TCGETA      0x5405
define TCSETA      0x5406
define TCSETAW     0x5407
define TCSETAF     0x5408
define TCSBRK      0x5409
define TCXONC      0x540A
define TCFLSH      0x540B
define TIOCEXCL    0x540C
define TIOCNXCL    0x540D
define TIOCSCTTY   0x540E
define TIOCGPGRP   0x540F
define TIOCSPGRP   0x5410
define TIOCOUTQ    0x5411
define TIOCSTI     0x5412
define TIOCGWINSZ  0x5413
define TIOCSWINSZ  0x5414
define TIOCMGET    0x5415
define TIOCMBIS    0x5416
define TIOCMBIC    0x5417
define TIOCMSET    0x5418
define TIOCGSOFTCAR 0x5419
define TIOCSSOFTCAR 0x541A
define TIOCLINUX   0x541C
define TIOCCONS    0x541D
define TIOCGSERIAL 0x541E
define TIOCSSERIAL 0x541F
define TIOCPKT     0x5420
define TIOCNOTTY   0x5422
define TIOCSETD    0x5423
define TIOCGETD    0x5424
define TCSBRKP     0x5425
define TIOCSBRK    0x5427
define TIOCCBRK    0x5428
define TIOCGSID    0x5429


define IGNBRK  0x0001
define BRKINT  0x0002
define IGNPAR  0x0004
define PARMRK  0x0008
define INPCK   0x0010
define ISTRIP  0x0020
define INLCR   0x0040
define IGNCR   0x0080
define ICRNL   0x0100
define IXON    0x0400
define IXANY   0x0800
define IXOFF   0x1000
define IMAXBEL 0x2000
define IUTF8   0x4000


define OPOST   0x0001
define ONLCR   0x0004
define OCRNL   0x0008
define ONOCR   0x0010
define ONLRET  0x0020
define OFILL   0x0040
define OFDEL   0x0080
define NLDLY   0x0100
define CRDLY   0x0600
define TABDLY  0x1800
define BSDLY   0x2000
define VTDLY   0x4000
define FFDLY   0x8000


define CSIZE   0x0030
define CS5     0x0000
define CS6     0x0010
define CS7     0x0020
define CS8     0x0030
define CSTOPB  0x0040
define CREAD   0x0080
define PARENB  0x0100
define PARODD  0x0200
define HUPCL   0x0400
define CLOCAL  0x0800


define B0      0x0000
define B50     0x0001
define B75     0x0002
define B110    0x0003
define B134    0x0004
define B150    0x0005
define B200    0x0006
define B300    0x0007
define B600    0x0008
define B1200   0x0009
define B1800   0x000A
define B2400   0x000B
define B4800   0x000C
define B9600   0x000D
define B19200  0x000E
define B38400  0x000F
define B57600  0x1001
define B115200 0x1002
define B230400 0x1003


define ISIG    0x0001
define ICANON  0x0002
define XCASE   0x0004
define ECHO    0x0008
define ECHOE   0x0010
define ECHOK   0x0020
define ECHONL  0x0040
define NOFLSH  0x0080
define TOSTOP  0x0100
define ECHOCTL 0x0200
define ECHOPRT 0x0400
define ECHOKE  0x0800
define FLUSHO  0x1000
define PENDIN  0x4000
define IEXTEN  0x8000


define VEOF    4
define VEOL    11
define VERASE  2
define VINTR   0
define VKILL   3
define VMIN    6
define VQUIT   1
define VSTART  8
define VSTOP   9
define VSUSP   10
define VTIME   5


define TIOCM_LE   0x001
define TIOCM_DTR  0x002
define TIOCM_RTS  0x004
define TIOCM_ST   0x008
define TIOCM_SR   0x010
define TIOCM_CTS  0x020
define TIOCM_CAR  0x040
define TIOCM_RNG  0x080
define TIOCM_DSR  0x100
define TIOCM_CD   TIOCM_CAR
define TIOCM_RI   TIOCM_RNG


define STDIN  0
define STDOUT 1
define STDERR 2


define term-or3 :: Int -> Int -> Int -> Int
  a b c -> bit-or (bit-or a b) c


define term-or4 :: Int -> Int -> Int -> Int -> Int
  a b c d -> bit-or (bit-or (bit-or a b) c) d


define term-or5 :: Int -> Int -> Int -> Int -> Int -> Int
  a b c d e -> bit-or (bit-or (bit-or (bit-or a b) c) d) e


define term-or8 :: Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int
  a b c d e f g h -> bit-or (term-or4 a b c d) (term-or4 e f g h)


define raw-iflag-mask (term-or8 IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON)


define raw-lflag-mask (term-or5 ECHO ECHONL ICANON IEXTEN ISIG)


define cbreak-lflag-mask (bit-or ECHO ICANON)


define sys-read :: Int -> *U8 -> Int -foreign-> Int
  fd buf len ->
    asm mov 0   %rax
        mov fd  %rdi
        mov buf %rsi
        mov len %rdx
        syscall ret


define sys-write :: Int -> *U8 -> Int -foreign-> Int
  fd buf len ->
    asm mov 1   %rax
        mov fd  %rdi
        mov buf %rsi
        mov len %rdx
        syscall ret


define sys-ioctl :: Int -> Int -> *a -foreign-> Int
  fd req arg ->
    asm mov 16  %rax
        mov fd  %rdi
        mov req %rsi
        mov arg %rdx
        syscall ret


define sys-ioctl-value :: Int -> Int -> Int -foreign-> Int
  fd req value ->
    asm mov 16    %rax
        mov fd    %rdi
        mov req   %rsi
        mov value %rdx
        syscall ret


define empty-termios :: Termios
  Termios (U32 0) (U32 0) (U32 0) (U32 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0)


define empty-winsize :: WinSize
  WinSize (U16 0) (U16 0) (U16 0) (U16 0)


define tty-get-attr-result :: Int -foreign-> Either Int Termios
  :doc "Read terminal attributes, preserving the raw ioctl status on failure."
  fd ->
    def value empty-termios
    def status (sys-ioctl fd TCGETS &value)
    if status < 0 then Left status else Right value


define tty-get-attr :: Int -foreign-> Termios
  :doc "Compatibility value observation; fails instead of fabricating attributes."
  fd ->
    (match (tty-get-attr-result fd) with
     | (Right value) -> value
     | (Left _) -> error "System.Posix.Term.tty-get-attr: TCGETS failed")


define tty-set-attr :: Int -> Termios -foreign-> Int
  :doc "Apply terminal attributes immediately via TCSETS."
  fd value -> sys-ioctl fd TCSETS &value


define tty-set-attr-drain :: Int -> Termios -foreign-> Int
  :doc "Apply terminal attributes after output drains via TCSETSW."
  fd value -> sys-ioctl fd TCSETSW &value


define tty-set-attr-flush :: Int -> Termios -foreign-> Int
  :doc "Apply terminal attributes after drain and input flush via TCSETSF."
  fd value -> sys-ioctl fd TCSETSF &value


define tty-raw-termios :: Termios -> Termios
  :doc "Return the Linux cfmakeraw-equivalent Termios value derived from ORIGINAL."
  original -> Termios
    (U32 ((Int original.c_iflag) & (~ raw-iflag-mask)))
    (U32 ((Int original.c_oflag) & (~ OPOST)))
    (U32 (bit-or ((Int original.c_cflag) & (~ (bit-or CSIZE PARENB))) CS8))
    (U32 ((Int original.c_lflag) & (~ raw-lflag-mask)))
    original.c_line
    original.c_cc0 original.c_cc1 original.c_cc2 original.c_cc3 original.c_cc4
    (U8 0) (U8 1) original.c_cc7 original.c_cc8 original.c_cc9
    original.c_cc10 original.c_cc11 original.c_cc12 original.c_cc13 original.c_cc14
    original.c_cc15 original.c_cc16 original.c_cc17 original.c_cc18


define tty-cbreak-termios :: Termios -> Termios
  :doc "Return a noncanonical no-echo Termios value derived from ORIGINAL."
  original -> Termios
    original.c_iflag original.c_oflag original.c_cflag
    (U32 ((Int original.c_lflag) & (~ cbreak-lflag-mask)))
    original.c_line
    original.c_cc0 original.c_cc1 original.c_cc2 original.c_cc3 original.c_cc4
    (U8 0) (U8 1) original.c_cc7 original.c_cc8 original.c_cc9
    original.c_cc10 original.c_cc11 original.c_cc12 original.c_cc13 original.c_cc14
    original.c_cc15 original.c_cc16 original.c_cc17 original.c_cc18


define terminal-mode-apply :: Int -> (Termios -> Termios) -> Termios -foreign-> Either Int Termios
  fd transform original ->
    def status (tty-set-attr fd (transform original))
    if status < 0 then Left status else Right original


define terminal-mode-from-result :: Int -> (Termios -> Termios) -> Either Int Termios -foreign-> Either Int Termios
  _ _ [Left status] -> Left status
  fd transform [Right original] -> terminal-mode-apply fd transform original


define terminal-mode-result :: Int -> (Termios -> Termios) -foreign-> Either Int Termios
  fd transform -> terminal-mode-from-result fd transform (tty-get-attr-result fd)


define tty-raw-mode-result :: Int -foreign-> Either Int Termios
  :doc "Enable raw mode and return the original attributes on success."
  fd -> terminal-mode-result fd tty-raw-termios


define tty-raw-mode :: Int -foreign-> Termios
  :doc "Compatibility raw-mode entry; fails if either TCGETS or TCSETS fails."
  fd ->
    (match (tty-raw-mode-result fd) with
     | (Right original) -> original
     | (Left _) -> error "System.Posix.Term.tty-raw-mode: terminal setup failed")


define tty-cbreak-mode-result :: Int -foreign-> Either Int Termios
  :doc "Enable cbreak mode and return the original attributes on success."
  fd -> terminal-mode-result fd tty-cbreak-termios


define tty-cbreak-mode :: Int -foreign-> Termios
  :doc "Compatibility cbreak entry; fails if either TCGETS or TCSETS fails."
  fd ->
    (match (tty-cbreak-mode-result fd) with
     | (Right original) -> original
     | (Left _) -> error "System.Posix.Term.tty-cbreak-mode: terminal setup failed")


define get-winsize-result :: Int -foreign-> Either Int WinSize
  :doc "Read terminal window dimensions without conflating failure with zero size."
  fd ->
    def value empty-winsize
    def status (sys-ioctl fd TIOCGWINSZ &value)
    if status < 0 then Left status else Right value


define get-winsize :: Int -foreign-> WinSize
  :doc "Compatibility window-size observation; fails if TIOCGWINSZ fails."
  fd ->
    (match (get-winsize-result fd) with
     | (Right value) -> value
     | (Left _) -> error "System.Posix.Term.get-winsize: TIOCGWINSZ failed")


define set-winsize :: Int -> WinSize -foreign-> Int
  :doc "Set terminal window dimensions via TIOCSWINSZ."
  fd ws -> (sys-ioctl fd TIOCSWINSZ &ws)


define tty-flush :: Int -> Int -foreign-> Int
  :doc "Flush terminal queue: 0 input, 1 output, 2 both."
  fd queue -> (sys-ioctl-value fd TCFLSH queue)


define tty-flow :: Int -> Int -foreign-> Int
  :doc "Suspend or resume terminal I/O flow."
  fd action -> (sys-ioctl-value fd TCXONC action)


define tty-send-break :: Int -> Int -foreign-> Int
  :doc "Send a terminal break."
  fd duration -> (sys-ioctl-value fd TCSBRK duration)


define tty-get-modem-result :: Int -foreign-> Either Int Int
  :doc "Read modem line bits while preserving ioctl failure."
  fd ->
    def bits 0
    def status (sys-ioctl fd TIOCMGET &bits)
    if status < 0 then Left status else Right bits


define tty-get-modem :: Int -foreign-> Int
  :doc "Compatibility modem observation; fails if TIOCMGET fails."
  fd ->
    (match (tty-get-modem-result fd) with
     | (Right bits) -> bits
     | (Left _) -> error "System.Posix.Term.tty-get-modem: TIOCMGET failed")


define tty-set-modem :: Int -> Int -foreign-> Int
  fd bits -> (sys-ioctl fd TIOCMSET &bits)


define tty-set-modem-bits :: Int -> Int -foreign-> Int
  fd bits -> (sys-ioctl fd TIOCMBIS &bits)


define tty-clear-modem-bits :: Int -> Int -foreign-> Int
  fd bits -> (sys-ioctl fd TIOCMBIC &bits)


define tty-get-pgrp-result :: Int -foreign-> Either Int Int
  fd ->
    def pgrp 0
    def status (sys-ioctl fd TIOCGPGRP &pgrp)
    if status < 0 then Left status else Right pgrp


define tty-get-pgrp :: Int -foreign-> Int
  fd ->
    (match (tty-get-pgrp-result fd) with
     | (Right pgrp) -> pgrp
     | (Left _) -> error "System.Posix.Term.tty-get-pgrp: TIOCGPGRP failed")


define tty-set-pgrp :: Int -> Int -foreign-> Int
  fd pgrp -> (sys-ioctl fd TIOCSPGRP &pgrp)


define tty-get-sid-result :: Int -foreign-> Either Int Int
  fd ->
    def sid 0
    def status (sys-ioctl fd TIOCGSID &sid)
    if status < 0 then Left status else Right sid


define tty-get-sid :: Int -foreign-> Int
  fd ->
    (match (tty-get-sid-result fd) with
     | (Right sid) -> sid
     | (Left _) -> error "System.Posix.Term.tty-get-sid: TIOCGSID failed")


define tty-make-controlling :: Int -foreign-> Int
  fd -> sys-ioctl-value fd TIOCSCTTY 0


define tty-release-controlling :: Int -foreign-> Int
  fd -> sys-ioctl-value fd TIOCNOTTY 0


define read-char :: Int -e-> Int
  where e has foreign
  fd -> def c 0
        def n (sys-read fd &c 1)
        if n <= 0 then -1 else c


define write-char :: Int -> Int -e-> Int
  where e has foreign
  fd c -> (sys-write fd &c 1)


define write-str :: Int -> *U8 -> Int -e-> Int
  where e has foreign
  fd s len -> (sys-write fd s len)


define read-buf :: Int -> *U8 -> Int -e-> Int
  where e has foreign
  fd buf len -> (sys-read fd buf len)


define termios-test-value :: Int -> Int -> Int -> Int -> Termios
  iflag oflag cflag lflag -> Termios
    (U32 iflag) (U32 oflag) (U32 cflag) (U32 lflag) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0) (U8 0)


define term-test-raw-iflag :: _ -> Int
  _ -> Int (tty-raw-termios (termios-test-value raw-iflag-mask OPOST (bit-or CS7 PARENB) raw-lflag-mask)).c_iflag


define term-test-raw-cflag :: _ -> Int
  _ -> Int (tty-raw-termios (termios-test-value 0 0 (bit-or CS7 PARENB) 0)).c_cflag


define term-test-raw-vmin :: _ -> Int
  _ -> Int (tty-raw-termios (termios-test-value 0 0 0 0)).c_cc6


define term-test-cbreak-lflag :: _ -> Int
  _ -> Int (tty-cbreak-termios (termios-test-value 0 0 0 cbreak-lflag-mask)).c_lflag


tests
  :constants:
  assert-eq termios-abi-version 2 "Term ABI version tracks the corrected Linux UAPI layout"
  assert-eq TCGETS     0x5401 "Term TCGETS"
  assert-eq TIOCGWINSZ 0x5413 "Term TIOCGWINSZ"
  assert-eq STDIN      0      "Term STDIN"
  assert-eq STDOUT     1      "Term STDOUT"
  assert-eq STDERR     2      "Term STDERR"
  :constants:

  :masks:
  assert-eq raw-iflag-mask    (term-or8 IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON) "Term raw iflag mask"
  assert-eq raw-lflag-mask    (term-or5 ECHO ECHONL ICANON IEXTEN ISIG)                        "Term raw lflag mask"
  assert-eq cbreak-lflag-mask (bit-or ECHO ICANON)                      "Term cbreak lflag mask"
  :masks:

  :layouts:
  assert-eq (term-test-raw-iflag 0)    0   "Term raw clears input flags"
  assert-eq (term-test-raw-cflag 0)    CS8 "Term raw clears size/parity and selects eight-bit characters"
  assert-eq (term-test-raw-vmin 0)     1   "Term raw mode makes one byte the minimum read"
  assert-eq (term-test-cbreak-lflag 0) 0   "Term cbreak clears canonical/echo flags"
  assert-eq (Int (empty-winsize.ws_row)) 0 "Term WinSize stores row as a 16-bit field"
  :layouts:
