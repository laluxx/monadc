;;; Network.mon --- Linux network syscall seam

:author "Laluxx"
:version "0.1.0"
:keywords "system posix sockets tcp foreign effects"

;;; Commentary:

 This module is the Linux ABI boundary beneath Network.Socket. It preserves
 raw syscall results and owns no application error policy.

;;; Code:

module System.Posix.Network
  [SockAddrIn
   AF_INET SOCK_STREAM SOCK_CLOEXEC SOL_SOCKET SO_REUSEADDR SO_RCVTIMEO SHUT_WR
   sys-socket sys-bind sys-listen sys-accept sys-accept-close-on-exec
   sys-recv sys-send-from sys-send-text-from sys-shutdown-write sys-receive-timeout
   sys-network-buffer-allocate sys-network-buffer-release]


define AF_INET      2
define SOCK_STREAM  1
define SOCK_CLOEXEC 0x80000
define SOL_SOCKET   1
define SO_REUSEADDR 2
define SO_RCVTIMEO  20
define SHUT_WR      1


layout SockAddrIn
  [family  :: U16]
  [port    :: U16]
  [address :: U32]
  [zero    :: U64]


layout Timeval
  [seconds      :: Int]
  [microseconds :: Int]


define sys-socket :: Int -> Int -> Int -foreign-> Int
  domain kind protocol ->
    asm mov 41       %rax
        mov domain   %rdi
        mov kind     %rsi
        mov protocol %rdx
        syscall ret


define sys-bind :: Int -> *SockAddrIn -> Int -foreign-> Int
  socket address size ->
    asm mov 49      %rax
        mov socket  %rdi
        mov address %rsi
        mov size    %rdx
        syscall ret


define sys-listen :: Int -> Int -foreign-> Int
  socket backlog ->
    asm mov 50      %rax
        mov socket  %rdi
        mov backlog %rsi
        syscall ret


define sys-accept :: Int -foreign-> Int
  socket ->
    asm mov 43     %rax
        mov socket %rdi
        mov 0      %rsi
        mov 0      %rdx
        syscall ret


define sys-accept-close-on-exec :: Int -foreign-> Int
  socket ->
    asm mov 288    %rax
        mov socket %rdi
        mov 0      %rsi
        mov 0      %rdx
        mov 0x80000 %r10
        syscall ret


define sys-reuse-address :: Int -foreign-> Int
  socket ->
    asm mov 1      %rcx
        push %rcx
        mov 54     %rax
        mov socket %rdi
        mov 1      %rsi
        mov 2      %rdx
        mov %rsp   %r10
        mov 4      %r8
        syscall
        add 8      %rsp
        ret


define sys-receive-timeout :: Int -> *Timeval -foreign-> Int
  socket timeout ->
    asm mov timeout %r10
        mov 54      %rax
        mov socket  %rdi
        mov 1       %rsi
        mov 20      %rdx
        mov 16      %r8
        syscall ret


define sys-recv :: Int -> *U8 -> Int -foreign-> Int
  socket buffer size ->
    asm mov 45     %rax
        mov socket %rdi
        mov buffer %rsi
        mov size   %rdx
        mov 0      %r10
        mov 0      %r8
        mov 0      %r9
        syscall ret


define sys-send-from :: Int -> *U8 -> Int -> Int -foreign-> Int
  socket buffer offset size ->
    asm mov size   %r9
        add buffer offset
        mov 44     %rax
        mov socket %rdi
        mov buffer %rsi
        mov %r9    %rdx
        mov 0x4000 %r10
        mov 0      %r8
        mov 0      %r9
        syscall ret


define sys-send-text-from :: Int -> String -> Int -> Int -foreign-> Int
  socket text offset size ->
    asm mov size   %r9
        add text offset
        mov 44     %rax
        mov socket %rdi
        mov text   %rsi
        mov %r9    %rdx
        mov 0x4000 %r10
        mov 0      %r8
        mov 0      %r9
        syscall ret


define sys-shutdown-write :: Int -foreign-> Int
  socket ->
    asm mov 48     %rax
        mov socket %rdi
        mov 1      %rsi
        syscall ret


define sys-network-buffer-allocate :: Int -foreign-> *U8
  size ->
    asm mov 9      %rax
        mov size   %rsi
        mov 0      %rdi
        mov 3      %rdx
        mov 0x22   %r10
        mov -1     %r8
        mov 0      %r9
        syscall ret


define sys-network-buffer-release :: *U8 -> Int -foreign-> Int
  buffer size ->
    asm mov 11     %rax
        mov buffer %rdi
        mov size   %rsi
        syscall ret
