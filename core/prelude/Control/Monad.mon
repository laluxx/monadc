;;; Monad.mon --- Monad abstractions

:author   Laluxx
:version  1.2.0
:keywords monad transformer reader state writer error comonad typeclass

;;; Commentary:

 Monad extends Applicative with value-dependent sequencing. An instance
 supplies bind and its failure policy; return is inherited from pure, while
 join and non-dependent sequencing are derived from bind.

 Reader, State, Writer, Error, transformers, and Comonad remain separate
 capability abstractions. Where a smaller lawful basis is already expressible,
 Core derives the redundant vocabulary here: reader from ask, state/modify from
 get/put, and extend from Functor + duplicate. MonadPlus remains distinct from
 Alternative because the latter currently also owns repetition combinators that
 are not lawful for every monadic choice structure.

;;; Code:

import Control.Applicative
import Data.Functor

module Control.Monad
  [Monad bind return join then fail
   MonadPlus mzero mplus
   MonadTrans lift
   MonadReader Env ask local reader
   MonadState State get put state modify
   MonadWriter Output tell listen pass
   MonadError Error throwError catchError
   Comonad extract duplicate extend]


class Applicative m => Monad m where
  bind   :: m a     -> (a -> m b) -> m b
  return :: a       -> m a
  join   :: m (m a) -> m a
  then   :: m a     -> m b -> m b
  fail   :: String  -> m a

  return x ->
    pure x

  join value ->
    bind value (lambda (x) x)

  then value next ->
    bind value (lambda (ignored) next)

  ;; higher-kinded: m :: Type -> Type
  ;; minimal complete definition: bind and fail, plus inherited pure/applyA


class Monad m => MonadPlus m where
  mzero :: m a
  mplus :: m a -> m a -> m a

  ;; MonadPlus deliberately remains distinct from Alternative. Core's
  ;; Alternative currently also owns repetition (`some`/`many`), which is not
  ;; lawful for every monadic choice structure: finite powersets, for example,
  ;; cannot represent the infinitely many repetition lengths of a non-empty
  ;; alternative. Choice laws should agree when a type implements both classes,
  ;; but one class is not an unconditional superclass of the other.


class MonadTrans t where
  lift :: Monad m => m a -> t m a

  ;; higher-kinded: t :: (Type -> Type) -> Type -> Type


class Monad m => MonadReader m where
  type Env m
  ask    :: m (Env m)
  local  :: (Env m -> Env m) -> m a -> m a
  reader :: (Env m -> a) -> m a

  reader f -> bind ask (lambda (environment) (pure (f environment)))

  ;; minimal complete definition: ask and local


class Monad m => MonadState m where
  type State m
  get    :: m (State m)
  put    :: State m -> m ()
  state  :: (State m -> (a, State m)) -> m a
  modify :: (State m -> State m) -> m ()

  state transition ->
    bind get (lambda (current)
      def result (transition current)
      bind (put (result 1)) (lambda (_) (pure (result 0))))

  modify transform ->
    bind get (lambda (current) (put (transform current)))

  ;; minimal complete definition: get and put


class Monad m => MonadWriter m where
  type Output m
  tell   :: Output m -> m ()
  listen :: m a -> m (a, Output m)
  pass   :: m (a, Output m -> Output m) -> m a


class Monad m => MonadError m where
  type Error m
  throwError :: Error m -> m a
  catchError :: m a -> (Error m -> m a) -> m a


class Functor w => Comonad w where
  extract   :: w a -> a
  duplicate :: w a -> w (w a)
  extend    :: (w a -> b) -> w a -> w b

  extend f value -> map f (duplicate value)

  ;; minimal complete definition: extract and duplicate
