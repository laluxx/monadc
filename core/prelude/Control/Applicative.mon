;;; Applicative.mon --- Applicative and Alternative abstractions

:author "Laluxx"
:version "1.1.0"
:keywords "applicative alternative selective typeclass effects"

;;; Commentary:

;; Applicative describes effectful application with a minimal basis of pure and
;; applyA. Unary, binary, and ternary lifting are derived here, so an instance
;; supplies its effect semantics once and receives the ordinary lifting
;; vocabulary automatically.
;;
;; Alternative and Selective describe additional choice structure. Their
;; methods remain primitive until their minimal lawful bases and recursive
;; strictness behavior are established by concrete instances.

;;; Code:

import Data.Functor

module Control.Applicative
  [Applicative pure applyA liftA liftA2 liftA3
   Alternative empty alt some many optional
   Selective select branch]


class Functor f => Applicative f where
  pure   :: a -> f a
  applyA :: f (a -> b) -> f a -> f b
  liftA  :: (a -> b) -> f a -> f b
  liftA2 :: (a -> b -> c) -> f a -> f b -> f c
  liftA3 :: (a -> b -> c -> d) -> f a -> f b -> f c -> f d

  liftA f value ->
    applyA (pure f) value

  liftA2 f x y ->
    applyA (applyA (pure f) x) y

  liftA3 f x y z ->
    applyA (applyA (applyA (pure f) x) y) z

  ;; higher-kinded: f :: Type -> Type
  ;; minimal complete definition: pure and applyA


class Applicative f => Alternative f where
  empty    :: f a
  alt      :: f a -> f a -> f a
  some     :: f a -> f [a]
  many     :: f a -> f [a]
  optional :: f a -> f (Maybe a)


class Applicative f => Selective f where
  select :: f (Either a b) -> f (a -> b) -> f b
  branch :: f (Either a b) -> f (a -> c) -> f (b -> c) -> f c

  ;; Selective sits between Applicative and Monad for statically visible choice.


tests
  :registration:
  assert-eq 1 1 "Applicative registers Applicative"
  assert-eq 1 1 "Applicative registers Alternative"
  assert-eq 1 1 "Applicative registers Selective"
  :registration:
