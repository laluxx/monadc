;;; Category.mon --- Category abstraction

:author "Laluxx"
:version "1.1.0"
:keywords "category identity composition typeclass"

;;; Commentary:

 Category describes identity arrows and right-to-left composition. Forward
 piping is the same operation with its arguments reversed and is therefore a
 shared default, not part of an instance's required implementation.

;;; Code:

module Control.Category
  [Category idCategory composeCategory pipeCategory]


class Category cat where
  idCategory      :: cat a a
  composeCategory :: cat b c -> cat a b -> cat a c
  pipeCategory    :: cat a b -> cat b c -> cat a c

  pipeCategory f g ->
    composeCategory g f

  ;; higher-kinded: cat :: Type -> Type -> Type
  ;; minimal complete definition: idCategory and composeCategory


tests
  :registration:
  assert-eq 1 1 "Category registers Category"
  :registration:
