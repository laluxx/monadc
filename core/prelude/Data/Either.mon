;;; Either.mon --- Typed alternatives and errors

:author   Laluxx
:version  1.2.0
:keywords either result error bifunctor typed-alternative

;;; Commentary:

 Either models computations with a typed error or alternative on the Left and
 a success value on the Right. It is the public Result-like building block for
 core code that needs more information than Maybe can carry.

 Bifunctor owns two-sided mapping. For a fixed Left type, Either is also a
 conventional fail-fast Functor and Applicative: the first Left in evaluation
 order wins, while Right values compose normally. A fully generic Monad
 instance is intentionally absent because Core Monad currently requires
 =fail :: String -> m a=; an arbitrary Left type cannot lawfully manufacture
 a value from String.

;;; Code:

import Data.Bool
import Data.Functor
import Control.Applicative

module Data.Either
  [Either Left Right
   either left? right?
   fromLeft fromRight
   mapLeft mapRight flatMap mapBoth]


data Either e a
  = Left  e
  | Right a


define bimap-either :: (e -> f) -> (a -> b) -> Either e a -> Either f b
  f g [Left e]  -> Left (f e)
  f g [Right x] -> Right (g x)


instance Bifunctor Either
  bimap f g value -> bimap-either f g value


define apply-either :: Either e (a -> b) -> Either e a -> Either e b
  [Left error] _          -> Left error
  [Right _] [Left error]  -> Left error
  [Right f] [Right value] -> Right (f value)


instance Functor (Either e)
  map f value -> bimap-either (lambda (error) error) f value


instance Applicative (Either e)
  pure value -> Right value
  applyA fvalue value -> apply-either fvalue value


method either :: Either e a -> (e -> c) -> (a -> c) -> c
  [Left e] f _  -> f e
  [Right x] _ g -> g x


method left? :: Either e a -> Bool
  [Left _]  -> True
  [Right _] -> False


method right? :: Either e a -> Bool
  [Right _] -> True
  [Left _]  -> False


method fromLeft :: Either e a -> e -> e
  [Left e] _       -> e
  [Right _] default -> default


method fromRight :: Either e a -> a -> a
  [Right x] _      -> x
  [Left _] default -> default


method mapLeft :: Either e a -> (e -> f) -> Either f a
  value f -> first-map f value


method mapRight :: Either e a -> (a -> b) -> Either e b
  value f -> second-map f value


method flatMap :: Either e a -> (a -> Either e b) -> Either e b
  [Left e] _  -> Left e
  [Right x] f -> f x


method mapBoth :: Either e a -> (e -> f) -> (a -> b) -> Either f b
  value f g -> bimap f g value


tests
  :eliminate:
  assert-eq ((Left 5).fromLeft 0)   5 "Either fromLeft Left"
  assert-eq ((Right 9).fromLeft 0)  0 "Either fromLeft Right"
  assert-eq ((Right 9).fromRight 0) 9 "Either fromRight Right"
  assert-eq ((Left 5).fromRight 0)  0 "Either fromRight Left"
  :eliminate:

  :predicates:
  assert-eq ((Left 1).left?)   True  "Either left? Left"
  assert-eq ((Left 1).left?)   True  "Either left? method syntax"
  assert-eq ((Right 1).left?)  False "Either left? Right"
  assert-eq ((Right 1).right?) True "Either right? Right"
  assert-eq ((Left 1).right?)  False "Either right? Left"
  :predicates:

  :bifunctor-defaults:
  assert-eq (show (first-map (lambda (x) (x + 1)) (Left 4)))  "(Left 5)"  "Either inherits Bifunctor first-map"
  assert-eq (show (first-map (lambda (x) (x + 1)) (Right 9))) "(Right 9)" "Either first-map preserves Right"
  assert-eq (show (second-map (lambda (x) (x + 1)) (Right 4))) "(Right 5)" "Either inherits Bifunctor second-map"
  assert-eq (show (second-map (lambda (x) (x + 1)) (Left 9)))  "(Left 9)"  "Either second-map preserves Left"
  :bifunctor-defaults:


  :applicative:
  assert-eq (show (map (lambda (x) (x + 1)) (Right 4))) "(Right 5)" "Either fixed-left Functor maps Right"
  assert-eq (show (map (lambda (x) (x + 1)) (Left "bad"))) "(Left bad)" "Either fixed-left Functor preserves Left"
  assert-eq (show (liftA2 (lambda (x y) (x + y)) (Right 2) (Right 3))) "(Right 5)" "Either inherits Applicative lifting"
  assert-eq (show (applyA (Left "function") (Left "argument"))) "(Left function)" "Either Applicative is deliberately fail-fast"
  :applicative:
