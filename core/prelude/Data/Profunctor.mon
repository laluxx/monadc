;;; Profunctor.mon --- Profunctor abstraction

:author "Laluxx"
:version "1.1.0"
:keywords "profunctor dimap contravariant covariant typeclass"

;;; Commentary:

 Profunctor maps its input contravariantly and its output covariantly.
 Instances supply the combined dimap operation; mapping either side alone is
 derived with an identity function so the directional laws have one owner.

;;; Code:

module Data.Profunctor
  [Profunctor dimap lmap rmap]


class Profunctor p where
  dimap :: (a -> b) -> (c -> d) -> p b c -> p a d
  lmap  :: (a -> b) -> p b c -> p a c
  rmap  :: (b -> c) -> p a b -> p a c

  lmap f value ->
    dimap f (lambda (x) x) value

  rmap g value ->
    dimap (lambda (x) x) g value

  ;; higher-kinded: p :: Type -> Type -> Type
  ;; minimal complete definition: dimap
  ;; law: lmap f = dimap f id
  ;; law: rmap g = dimap id g


tests
  :registration:
  assert-eq 1 1 "Profunctor registers Profunctor"
  :registration:
