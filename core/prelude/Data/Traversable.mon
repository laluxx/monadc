;;; Traversable.mon --- Traversal abstractions

:author   Laluxx
:version  1.2.0
:keywords traversable applicative monad traverse sequence keyed typeclass

;;; Commentary:

 Traversable sequences one finite structure through an Applicative effect while
 preserving its shape. The effect constraints are part of the operation
 signatures: a completely unconstrained f cannot support traversal.

 traverse is the minimal primitive. sequenceA, mapM, and sequence are ordinary
 specializations/derivations, preventing instances from defining four subtly
 different traversal orders. Keyed traversal likewise derives pure keyed
 mapping from Functor rather than duplicating it.

;;; Code:

import Data.Functor
import Data.Foldable
import Control.Applicative
import Control.Monad

module Data.Traversable
  [Traversable traverse sequenceA mapM sequence
   TraversableWithKey traverseWithKey mapWithKey]


class (Functor t, Foldable t) => Traversable t where
  traverse  :: Applicative f => (a -> f b) -> t a -> f (t b)
  sequenceA :: Applicative f => t (f a) -> f (t a)
  mapM      :: Monad m => (a -> m b) -> t a -> m (t b)
  sequence  :: Monad m => t (m a) -> m (t a)

  sequenceA values ->
    traverse (lambda (value) value) values

  mapM transform values ->
    traverse transform values

  sequence values ->
    traverse (lambda (value) value) values

  ;; higher-kinded: t, f, m :: Type -> Type
  ;; minimal complete definition: traverse
  ;;
  ;; laws: identity, composition, and naturality follow the standard
  ;; Traversable contract and must preserve the structure's traversal order.


class (Traversable t, FoldableWithKey t) => TraversableWithKey t where
  traverseWithKey :: Applicative f => (Key t -> a -> f b) -> t a -> f (t b)
  mapWithKey      :: (Key t -> a -> b) -> t a -> t b

  ;; Key is inherited from FoldableWithKey, so keyed folds and traversals cannot
  ;; silently disagree about the index domain. mapWithKey remains primitive
  ;; until Core has a universally available Identity applicative whose erasure
  ;; semantics are part of the foundation.
