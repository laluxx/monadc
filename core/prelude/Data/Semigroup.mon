;;; Semigroup.mon --- Associative append abstractions

:author "Laluxx"
:version "1.2.0"
:keywords "semigroup monoid append algebra typeclass fold"

;;; Commentary:

;; Semigroup owns associative same-shaped combination. An instance supplies
;; only append; non-empty concatenation is derived once here for every
;; instance. Monoid adds only the identity element, from which ordinary binary
;; and whole-collection combination are also derived.
;;
;; This minimal basis is intentional: an instance should describe its algebra,
;; not duplicate generic recursion. Backends may specialize these defaults to
;; representation primitives when doing so preserves the class laws.

;;; Code:

import Data.Bool

module Data.Semigroup
  [Semigroup append sconcat
   Monoid mempty mappend mconcat]


class Semigroup a where
  append  :: a -> a -> a
  sconcat :: [a] -> a

  sconcat []       ->
    error "Semigroup.sconcat: empty sequence"

  sconcat [x|[]]   ->
    x

  sconcat [x|xs]   ->
    append x (sconcat xs)

  law associativity :: Eq a => a -> a -> a -> Bool
    x y z -> eq? (append (append x y) z) (append x (append y z))

  ;; minimal complete definition: append


class Semigroup a => Monoid a where
  mempty  :: a
  mappend :: a -> a -> a
  mconcat :: [a] -> a

  mappend x y ->
    append x y

  mconcat [] ->
    mempty

  mconcat [x|xs] ->
    mappend x (mconcat xs)

  law left-identity :: Eq a => a -> Bool
    x -> eq? (mappend mempty x) x

  law right-identity :: Eq a => a -> Bool
    x -> eq? (mappend x mempty) x

  ;; minimal complete definition: mempty, plus inherited append


instance Semigroup Int
  append x y -> x + y


instance Semigroup Bool
  append x y -> x and y


instance Semigroup String
  append left right -> __rt_concat left right


instance Monoid Bool
  mempty -> True
  mappend x y -> append x y


instance Monoid String
  mempty -> ""


instance Semigroup Coll
  append xs ys -> __rt_concat xs ys


instance Monoid Coll
  mempty -> list


tests
  :registration:
  assert-eq 1 1 "Semigroup registers Semigroup"
  assert-eq 1 1 "Semigroup registers Monoid"
  :registration:

  :int-semigroup:
  assert-eq (append 2 3) 5 "Semigroup Int append"
  assert-eq (sconcat (list 2 3 4)) 9 "Semigroup Int sconcat folds every member"
  assert-eq (append (append 1 2) 3) (append 1 (append 2 3)) "Semigroup Int append associative"
  :int-semigroup:

  :collection-monoid:
  assert-eq (show (append (list 1 2) (list 3 4))) "(1 2 3 4)" "Semigroup Coll append"
  assert-eq (show (sconcat (list (list 1) (list 2 3)))) "(1 2 3)" "Semigroup Coll sconcat"
  assert-eq (show (mconcat (list (list 1) (list 2 3)))) "(1 2 3)" "Monoid Coll mconcat"
  assert-eq (show mempty) "()" "Monoid Coll identity"
  :collection-monoid:

  :surface-operator-dispatch:
  assert-eq (True ++ False) False "++ resolves the core Semigroup Bool instance"
  assert-eq (True ++ True)  True  "++ is not compiler-specialized to collections"
  assert-eq ("modal" ++ " logic") "modal logic" "++ resolves the core Semigroup String instance"
  :surface-operator-dispatch:
