;;; Stream.mon --- incremental delimiter framing for byte streams

:author   Laluxx
:version  0.2.0
:keywords text parser stream bytes framing

;;; Commentary:

 Text.Parser.Stream separates transport fragmentation from grammar parsing.
 Feed arbitrary byte fragments until a non-empty delimiter completes one
 bounded frame; bytes after that delimiter are returned untouched.

 The delimiter is part of the returned frame. Empty delimiters are rejected
 explicitly because they have no meaningful incremental completion boundary
 and would otherwise require dequeuing an empty rolling window. Limits are
 measured in bytes already accepted into the frame.

;;; Code:

import Sequence
import Data.Queue

module Text.Parser.Stream
  [ParserStream ParserStreamReply ParserStreamPartial ParserStreamComplete
   ParserStreamRejected parser-stream feed-until stream-partial?
   stream-complete? stream-rejected? stream-state-or stream-frame-or
   stream-rest-or stream-error-offset-or]


layout ParserStream
  [limit       :: Int]
  [size        :: Int]
  [bytes       :: Queue Byte]
  [window      :: Queue Byte]
  [window-size :: Int]


data ParserStreamReply
  = ParserStreamPartial ParserStream
  | ParserStreamComplete [Byte] [Byte]
  | ParserStreamRejected Int


define parser-stream :: Int -> ParserStream
  :doc "Create an empty incremental frame with a non-negative maximum of LIMIT bytes."
  limit | (< limit 0) -> ParserStream 0 0 EmptyQueue EmptyQueue 0
  limit -> ParserStream limit 0 EmptyQueue EmptyQueue 0


define stream-partial? :: ParserStreamReply -> Bool
  [ParserStreamPartial state] -> True
  _ -> False


define stream-complete? :: ParserStreamReply -> Bool
  [ParserStreamComplete frame rest] -> True
  _ -> False


define stream-rejected? :: ParserStreamReply -> Bool
  [ParserStreamRejected offset] -> True
  _ -> False


define stream-state-or :: ParserStream -> ParserStreamReply -> ParserStream
  _ [ParserStreamPartial state] -> state
  fallback _ -> fallback


define stream-frame-or :: [Byte] -> ParserStreamReply -> [Byte]
  _ [ParserStreamComplete frame rest] -> frame
  fallback _ -> fallback


define stream-rest-or :: [Byte] -> ParserStreamReply -> [Byte]
  _ [ParserStreamComplete frame rest] -> rest
  fallback _ -> fallback


define stream-error-offset-or :: Int -> ParserStreamReply -> Int
  _ [ParserStreamRejected offset] -> offset
  fallback _ -> fallback


define push-window :: Int -> ParserStream -> Byte -> Queue Byte
  width stream byte | (>= stream.window-size width) ->
    enqueue (dequeue stream.window) byte
  _ stream byte -> enqueue stream.window byte


define pushed-window-size :: Int -> ParserStream -> Int
  width stream | (>= stream.window-size width) -> width
  _ stream -> stream.window-size + 1


define push-byte :: [Byte] -> ParserStream -> Byte -> ParserStream
  ending stream byte ->
    ParserStream stream.limit (stream.size + 1) (enqueue stream.bytes byte) (push-window (count ending) stream byte) (pushed-window-size (count ending) stream)


define frame-finished? :: [Byte] -> ParserStream -> Bool
  ending stream -> (= (queue-to-list stream.window) ending)


define stream-bytes :: ParserStream -> [Byte]
  stream -> queue-to-list stream.bytes


define feed-until :: [Byte] -> ParserStream -> [Byte] -> ParserStreamReply
  :doc "Feed BYTES until non-empty ENDING completes a frame or STREAM reaches its limit."
  [] stream _ -> ParserStreamRejected stream.size
  _ stream [] -> ParserStreamPartial stream
  ending stream [byte|rest]
    | (>= stream.size stream.limit) -> ParserStreamRejected stream.size
    | frame-finished? ending (push-byte ending stream byte) ->
        ParserStreamComplete (stream-bytes (push-byte ending stream byte)) rest
    | otherwise ->
        feed-until ending (push-byte ending stream byte) rest


define parser-stream-test-ending :: [Byte]
  ⌜0x0d 0x0a⌝


tests
  :invalid-contract:
  assert-eq
    (stream-rejected? (feed-until [] (parser-stream 8) ⌜0x41⌝))
    True
    "Parser.Stream rejects an empty delimiter"
  assert-eq
    (stream-error-offset-or -1 (feed-until parser-stream-test-ending (parser-stream -1) ⌜0x41⌝))
    0
    "Parser.Stream normalizes a negative byte limit to zero"
  :invalid-contract:

  :fragmentation:
  def first-fragment
    (feed-until parser-stream-test-ending (parser-stream 8) ⌜0x41 0x0d⌝)
  assert-eq (stream-partial? first-fragment) True "Parser.Stream keeps a split delimiter partial"
  def first-state
    (stream-state-or (parser-stream 0) first-fragment)
  def completed-fragment
    (feed-until parser-stream-test-ending first-state ⌜0x0a 0x42⌝)
  assert-eq (stream-complete? completed-fragment) True "Parser.Stream completes a fragmented delimiter"
  assert-eq (count (stream-frame-or [] completed-fragment)) 3 "Parser.Stream frame includes its delimiter"
  assert-eq (count (stream-rest-or [] completed-fragment)) 1 "Parser.Stream preserves bytes after the delimiter"
  :fragmentation:

  :limit:
  def over-limit
    (feed-until parser-stream-test-ending (parser-stream 2) ⌜0x41 0x42 0x43⌝)
  assert-eq (stream-rejected? over-limit) True "Parser.Stream enforces the frame limit"
  assert-eq (stream-error-offset-or -1 over-limit) 2 "Parser.Stream reports the accepted-byte offset"
  :limit:
