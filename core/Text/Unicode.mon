;;; Unicode.mon --- Core-owned Unicode text algorithms

:author   Laluxx
:version  1.2.0
:keywords unicode utf-8 scalar value grapheme terminal width text
:reference-well-formed-utf8 "https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/"
:reference-rfc3629 "https://www.rfc-editor.org/rfc/rfc3629.html"

;;; Commentary:

 This module owns Unicode semantics in Monad source.  String remains the
 language's compact UTF-8 representation, while every operation below is
 expressed through ordinary String/Sequence indexing, arithmetic, algebraic
 data, recursion, and pattern matching.  No Unicode operation is a privileged
 compiler or runtime builtin.

 The API deliberately distinguishes four quantities which are often confused:

   byte-count      UTF-8 code units in the String representation
   scalar-count    decoded Unicode scalar values
   grapheme-count  user-perceived extended grapheme clusters
   display-width   terminal columns occupied by those clusters

 String is the byte-addressed representation described by Data.String; it is
 not itself proof that the bytes are well-formed UTF-8. =byte-count= therefore
 reports representation code units, =valid-utf8?=  validates canonical UTF-8,
 and =decode-utf8= accepts only text that passes that validation. Surrogates,
 overlong encodings, stray continuation bytes, truncated sequences, and values
 above U+10FFFF are rejected rather than smuggled into Unicode semantics.

 UnicodeScalar is the proof-carrying value-level boundary introduced in this
 cycle. Arbitrary integers can be checked once with =unicode-scalar=; successful
 construction yields an opaque scalar that =encode-unicode-scalar= cannot reject.
 Result-returning encode/decode functions preserve malformed-input information,
 while the historical Int APIs remain compatibility surfaces with explicitly
 documented partial or replacement behavior.

 =utf8-prefix-width= recognizes exactly one canonical sequence from Unicode
 Table 3-7. Returning zero distinguishes malformed, truncated, overlong,
 surrogate, and out-of-range octet prefixes without manufacturing replacement
 text. Protocol decoders such as Data.Json can therefore reject invalid input
 before it enters String.

 UTF-8 scalar validity is pinned to Unicode 17.0.0. The current grapheme and
 terminal-width layer is an explicitly tested algorithmic subset, not yet a
 full UAX #29 / East_Asian_Width conformance claim: it covers CR/LF, algorithmic
 Hangul joining, the combining/variation ranges listed below, regional-indicator
 pairing, and the currently modelled emoji-ZWJ behavior.

 Full Unicode segmentation requires generated Grapheme_Cluster_Break,
 Extended_Pictographic, and width-property tables. Until those tables are part
 of Core, callers that require exhaustive Unicode 17 segmentation must not
 treat grapheme-count/display-width as conformance oracles. This limitation is
 stated here rather than hidden behind an over-broad version claim.

;;; Code:

import Sequence
import Data.Bool
import Data.Char
import Data.Either
import Function
import Text.Format

module Text.Unicode
  [UnicodeScalar UnicodeError MalformedUTF8 InvalidScalar
   unicode-version replacement-character replacement-scalar
   unicode-scalar unicode-scalar-value
   byte-count valid-scalar? ascii-byte? continuation-byte? utf8-prefix-width bytes-prefix->text
   valid-utf8? decode-utf8 decode-utf8-scalars-result
   encode-scalar encode-scalar-result encode-unicode-scalar
   scalars->text scalars->text-result scalar-count
   grapheme-count display-width text-width]


define unicode-version :: String "17.0.0"


data UnicodeError
  = MalformedUTF8
  | InvalidScalar Int


| UnicodeScalar is opaque outside this module. Construction validates the
| Unicode scalar-value invariant once, after which encoders and algorithms do
| not need to repeatedly accept arbitrary Int values as if they were proved
| Unicode data.
data UnicodeScalar
  = UnicodeScalarValue Int


define replacement-character :: Int 0xfffd


define replacement-scalar :: UnicodeScalar
  UnicodeScalarValue replacement-character


define valid-scalar? :: Int -> Bool
  scalar | < 0        -> False
         | > 0x10ffff -> False
         | < 0xd800   -> True
         | > 0xdfff   -> True
         | otherwise  -> False


define unicode-scalar :: Int -> Either UnicodeError UnicodeScalar
  value | valid-scalar? value -> Right (UnicodeScalarValue value)
        | otherwise           -> Left (InvalidScalar value)


define unicode-scalar-value :: UnicodeScalar -> Int
  [UnicodeScalarValue value] -> value


define byte-count :: String -> Int
  text -> length text


define ascii-byte? :: Int -> Bool
  byte | >= 0 and <= 0x7f -> True
       | otherwise        -> False


define continuation-byte? :: Int -> Bool
  byte | >= 0x80 and <= 0xbf -> True
       | otherwise           -> False


define utf8-prefix-width :: [Int] -> Int
  [first second third fourth|rest]
    | and? (= first 0xf0) (and? (>= second 0x90) (and? (<= second 0xbf) (and? (continuation-byte? third) (continuation-byte? fourth)))) -> 4
    | and? (>= first 0xf1) (and? (<= first 0xf3) (and? (continuation-byte? second) (and? (continuation-byte? third) (continuation-byte? fourth)))) -> 4
    | and? (= first 0xf4) (and? (>= second 0x80) (and? (<= second 0x8f) (and? (continuation-byte? third) (continuation-byte? fourth)))) -> 4
  [first second third|rest]
    | and? (= first 0xe0) (and? (>= second 0xa0) (and? (<= second 0xbf) (continuation-byte? third))) -> 3
    | and? (>= first 0xe1) (and? (<= first 0xec) (and? (continuation-byte? second) (continuation-byte? third))) -> 3
    | and? (= first 0xed) (and? (>= second 0x80) (and? (<= second 0x9f) (continuation-byte? third))) -> 3
    | and? (>= first 0xee) (and? (<= first 0xef) (and? (continuation-byte? second) (continuation-byte? third))) -> 3
  [first second|rest]
    | and? (>= first 0xc2) (and? (<= first 0xdf) (continuation-byte? second)) -> 2
  [first|rest]
    | first <= 0x7f -> 1
    | otherwise     -> 0
  []                -> 0


define bytes-prefix->text :: Int -> [Int] -> String
  width [] -> ""
  width [byte|rest]
    | width <= 0 -> ""
    | otherwise  -> ((char->text (chr byte)) ++ (bytes-prefix->text (width - 1) rest))


define byte-between? :: Int -> Int -> Int -> Bool
  value low high -> (and? (>= value low) (<= value high))


define continuation-in? :: Int -> Int -> Int -> Bool
  value low high | byte-between? value low high -> continuation-byte? value
  _ _ _ -> False

define two-continuations? :: Int -> Int -> Bool
  first second -> (and? (continuation-byte? first) (continuation-byte? second))


define valid-two-at? :: String -> Int -> Int -> Bool
  _ index size | (index + 1) >= size -> False
  text index size ->
    def first (byte-at text index)
    def second (byte-at text (index + 1))
    if byte-between? first 0xc2 0xdf then continuation-byte? second else False


define valid-three-at? :: String -> Int -> Int -> Bool
  _ index size | (>= (index + 2) size) -> False
  text index _ | (= (byte-at text index) 0xe0) ->
    (and? (continuation-in? (byte-at text (index + 1)) 0xa0 0xbf) (continuation-byte? (byte-at text (index + 2))))
  text index _ | byte-between? (byte-at text index) 0xe1 0xec ->
    (and? (continuation-byte? (byte-at text (index + 1))) (continuation-byte? (byte-at text (index + 2))))
  text index _ | (= (byte-at text index) 0xed) ->
    (and? (continuation-in? (byte-at text (index + 1)) 0x80 0x9f) (continuation-byte? (byte-at text (index + 2))))
  text index _ | byte-between? (byte-at text index) 0xee 0xef ->
    (and? (continuation-byte? (byte-at text (index + 1))) (continuation-byte? (byte-at text (index + 2))))
  _ _ _ -> False


define valid-four-at? :: String -> Int -> Int -> Bool
  _ index size | (>= (index + 3) size) -> False
  text index _ | (= (byte-at text index) 0xf0) ->
    (and? (continuation-in? (byte-at text (index + 1)) 0x90 0xbf) (two-continuations? (byte-at text (index + 2)) (byte-at text (index + 3))))
  text index _ | byte-between? (byte-at text index) 0xf1 0xf3 ->
    (and? (continuation-byte? (byte-at text (index + 1))) (two-continuations? (byte-at text (index + 2)) (byte-at text (index + 3))))
  text index _ | (= (byte-at text index) 0xf4) ->
    (and? (continuation-in? (byte-at text (index + 1)) 0x80 0x8f) (two-continuations? (byte-at text (index + 2)) (byte-at text (index + 3))))
  _ _ _ -> False


define utf8-width-at :: String -> Int -> Int -> Int
  _ index size | (>= index size) -> 0
  text index _ | ascii-byte? (byte-at text index) -> 1
  text index size | valid-two-at? text index size -> 2
  text index size | valid-three-at? text index size -> 3
  text index size | valid-four-at? text index size -> 4
  _ _ _ -> 0


define valid-utf8-from? :: String -> Int -> Int -> Bool
  _ index size | (>= index size) -> True
  text index size ->
    def width (utf8-width-at text index size)
    if width = 0 then False else valid-utf8-from? text (index + width) size


define valid-utf8? :: String -> Bool
  text -> valid-utf8-from? text 0 (byte-count text)


define byte-text :: Int -> String
  byte -> (char->text (chr byte))


define encode-valid-scalar :: Int -> String
  scalar
    | scalar <= 0x7f   -> byte-text scalar
    | scalar <= 0x7ff  -> ((byte-text (0xc0 + (scalar / 0x40))) ++ (byte-text (0x80 + (scalar % 0x40))))
    | scalar <= 0xffff -> ((byte-text (0xe0 + (scalar / 0x1000))) ++ (byte-text (0x80 + ((scalar / 0x40) % 0x40))) ++ (byte-text (0x80 + (scalar % 0x40))))
    | otherwise        -> ((byte-text (0xf0 + (scalar / 0x40000))) ++ (byte-text (0x80 + ((scalar / 0x1000) % 0x40))) ++ (byte-text (0x80 + ((scalar / 0x40) % 0x40))) ++ (byte-text (0x80 + (scalar % 0x40))))


define encode-unicode-scalar :: UnicodeScalar -> String
  [UnicodeScalarValue scalar] -> encode-valid-scalar scalar


define encode-scalar-result :: Int -> Either UnicodeError String
  scalar ->
    (match (unicode-scalar scalar) with
     | (Left error) -> (Left error)
     | (Right value) -> (Right (encode-unicode-scalar value)))


| Compatibility encoder: malformed scalar integers become U+FFFD. New code
| that must distinguish invalid input should use encode-scalar-result or the
| opaque UnicodeScalar API instead of relying on replacement semantics.
define encode-scalar :: Int -> String
  scalar ->
    (match (encode-scalar-result scalar) with
     | (Left _) -> (encode-unicode-scalar replacement-scalar)
     | (Right text) -> text)


define scalars->text :: [Int] -> String
  []            -> ""
  [scalar|rest] -> (encode-scalar scalar) ++ (scalars->text rest)


define scalars->text-result :: [Int] -> Either UnicodeError String
  [] -> Right ""
  [scalar|rest] ->
    (match (encode-scalar-result scalar) with
     | (Left error) -> (Left error)
     | (Right head) ->
         (match (scalars->text-result rest) with
          | (Left error) -> (Left error)
          | (Right tail) -> (Right (head ++ tail))))


define prepend-scalar :: Int -> [Int] -> [Int]
  scalar scalars -> prepend scalar scalars


define empty-scalars :: Int -> [Int]
  _ -> (list)


define byte-at :: String -> Int -> Int
  text index -> ord (text index)


define decode-two :: Int -> Int -> Int
  first second -> ((first - 0xc0) * 0x40) + (second - 0x80)


define decode-three :: Int -> Int -> Int -> Int
  first second third -> ((first - 0xe0) * 0x1000) + ((second - 0x80) * 0x40) + (third - 0x80)


define decode-four :: Int -> Int -> Int -> Int -> Int
  first second third fourth -> ((first - 0xf0) * 0x40000) + ((second - 0x80) * 0x1000) + ((third - 0x80) * 0x40) + (fourth - 0x80)


define decode-utf8-from :: String -> Int -> Int -> [Int]
  text index size
    | index >= size -> empty-scalars 0
    | (byte-at text index) <= 0x7f -> prepend-scalar (byte-at text index) (decode-utf8-from text (index + 1) size)
    | (byte-at text index) <= 0xdf -> prepend-scalar (decode-two (byte-at text index) (byte-at text (index + 1))) (decode-utf8-from text (index + 2) size)
    | (byte-at text index) <= 0xef -> prepend-scalar (decode-three (byte-at text index) (byte-at text (index + 1)) (byte-at text (index + 2))) (decode-utf8-from text (index + 3) size)
    | otherwise -> prepend-scalar (decode-four (byte-at text index) (byte-at text (index + 1)) (byte-at text (index + 2)) (byte-at text (index + 3))) (decode-utf8-from text (index + 4) size)


define decode-utf8 :: String -> [Int]
  text | valid-utf8? text -> decode-utf8-from text 0 (byte-count text)
  _ -> error "Text.Unicode.decode-utf8: malformed UTF-8"


define wrap-unicode-scalars :: [Int] -> [UnicodeScalar]
  [] -> []
  [value|rest] -> prepend (UnicodeScalarValue value) (wrap-unicode-scalars rest)


define decode-utf8-scalars-result :: String -> Either UnicodeError [UnicodeScalar]
  text | valid-utf8? text -> Right (wrap-unicode-scalars (decode-utf8-from text 0 (byte-count text)))
  _ -> Left MalformedUTF8


define scalar-count :: String -> Int
  text -> length (decode-utf8 text)


| These predicates are the algorithmic layer used by the segmentation and
| width engines.  Generated Unicode 17 property tables extend these ranges;
| algorithmic Hangul, variation-selector, and control ranges stay in source.

define combining-scalar? :: Int -> Bool
  scalar | >= 0x0300 and <= 0x036f -> True
         | >= 0x1ab0 and <= 0x1aff -> True
         | >= 0x1dc0 and <= 0x1dff -> True
         | >= 0x20d0 and <= 0x20ff -> True
         | >= 0xfe20 and <= 0xfe2f -> True
         | otherwise               -> False


define variation-selector? :: Int -> Bool
  scalar | >= 0xfe00  and <= 0xfe0f  -> True
         | >= 0xe0100 and <= 0xe01ef -> True
         | otherwise                 -> False


define regional-indicator? :: Int -> Bool
  scalar | >= 0x1f1e6 and <= 0x1f1ff -> True
         | otherwise                 -> False


define hangul-l? :: Int -> Bool
  scalar | >= 0x1100 and <= 0x115f -> True
         | >= 0xa960 and <= 0xa97c -> True
         | otherwise               -> False


define hangul-v? :: Int -> Bool
  scalar | >= 0x1160 and <= 0x11a7 -> True
         | >= 0xd7b0 and <= 0xd7c6 -> True
         | otherwise               -> False


define hangul-t? :: Int -> Bool
  scalar | >= 0x11a8 and <= 0x11ff -> True
         | >= 0xd7cb and <= 0xd7fb -> True
         | otherwise               -> False


define hangul-syllable? :: Int -> Bool
  scalar | >= 0xac00 and <= 0xd7a3 -> True
         | otherwise               -> False


define hangul-lv? :: Int -> Bool
  scalar | hangul-syllable? scalar -> hangul-lv-offset? scalar
         | otherwise               -> False


define hangul-lv-offset? :: Int -> Bool
  scalar | (scalar - 0xac00) % 28 = 0 -> True
         | otherwise                  -> False


define hangul-lvt? :: Int -> Bool
  scalar | hangul-syllable? scalar -> hangul-lvt-offset? scalar
         | otherwise               -> False


define hangul-lvt-offset? :: Int -> Bool
  scalar | (scalar - 0xac00) % 28 != 0 -> True
         | otherwise                   -> False


define crlf-pair? :: Int -> Int -> Bool
  previous current
    | previous = 0x0d -> line-feed? current
    | otherwise       -> False


define line-feed? :: Int -> Bool
  scalar | = 0x0a    -> True
         | otherwise -> False


define hangul-after-l? :: Int -> Bool
  scalar | hangul-l? scalar   -> True
         | hangul-v? scalar   -> True
         | hangul-lv? scalar  -> True
         | hangul-lvt? scalar -> True
         | otherwise          -> False


define hangul-after-v? :: Int -> Bool
  scalar | hangul-v? scalar -> True
         | hangul-t? scalar -> True
         | otherwise        -> False


define hangul-no-break? :: Int -> Int -> Bool
  previous current
    | hangul-l? previous   -> hangul-after-l? current
    | hangul-lv? previous  -> hangul-after-v? current
    | hangul-v? previous   -> hangul-after-v? current
    | hangul-lvt? previous -> hangul-t? current
    | hangul-t? previous   -> hangul-t? current
    | otherwise            -> False


define regional-pair? :: Int -> Int -> Int -> Bool
  previous current regional-run
    | regional-indicator? previous -> regional-current-pair? current regional-run
    | otherwise                    -> False


define regional-current-pair? :: Int -> Int -> Bool
  current regional-run
    | regional-indicator? current -> odd? regional-run
    | otherwise                   -> False


define odd? :: Int -> Bool
  value | value % 2 = 1 -> True
        | otherwise     -> False


define grapheme-no-break? :: Int -> Int -> Int -> Int -> Bool
  previous current regional-run previous-joiner
    | crlf-pair? previous current -> True
    | hangul-no-break? previous current -> True
    | combining-scalar? current -> True
    | variation-selector? current -> True
    | current = 0x200d -> True
    | previous-joiner = 1 -> True
    | regional-pair? previous current regional-run -> True
    | otherwise -> False


define next-regional-run :: Int -> Int -> Int
  scalar regional-run
    | regional-indicator? scalar -> regional-run + 1
    | otherwise                  -> 0


define joiner-code :: Int -> Int
  scalar | = 0x200d  -> 1
         | otherwise -> 0


define grapheme-count-scalars :: [Int] -> Int -> Int -> Int -> Int -> Int
  scalars count previous regional-run previous-joiner
    | null? scalars -> id count
    | previous < 0 -> grapheme-count-scalars (drop 1 scalars) 1 (nth scalars 0) (next-regional-run (nth scalars 0) 0) 0
    | grapheme-no-break? previous (nth scalars 0) regional-run previous-joiner -> grapheme-count-scalars (drop 1 scalars) count (nth scalars 0) (next-regional-run (nth scalars 0) regional-run) (joiner-code (nth scalars 0))
    | otherwise -> grapheme-count-scalars (drop 1 scalars) (count + 1) (nth scalars 0) (next-regional-run (nth scalars 0) 0) (joiner-code (nth scalars 0))


define grapheme-count :: String -> Int
  text -> grapheme-count-scalars (decode-utf8 text) 0 -1 0 0


define control-scalar? :: Int -> Bool
  scalar | < 0x20             -> True
         | >= 0x7f and < 0xa0 -> True
         | otherwise          -> False


define wide-scalar? :: Int -> Bool
  scalar | >= 0x1100  and <= 0x115f  -> True
         | = 0x2329                  -> True
         | = 0x232a                  -> True
         | >= 0x2e80  and <= 0xa4cf  -> True
         | >= 0xac00  and <= 0xd7a3  -> True
         | >= 0xf900  and <= 0xfaff  -> True
         | >= 0xfe10  and <= 0xfe19  -> True
         | >= 0xfe30  and <= 0xfe6f  -> True
         | >= 0xff00  and <= 0xff60  -> True
         | >= 0xffe0  and <= 0xffe6  -> True
         | >= 0x1f300 and <= 0x1faff -> True
         | >= 0x20000 and <= 0x3fffd -> True
         | otherwise                 -> False


define scalar-width :: Int -> Int
  scalar | control-scalar? scalar     -> 0
         | combining-scalar? scalar   -> 0
         | variation-selector? scalar -> 0
         | = 0x200d                   -> 0
         | regional-indicator? scalar -> 2
         | wide-scalar? scalar        -> 2
         | otherwise                  -> 1


define maximum :: Int -> Int -> Int
  left right
    | left >= right -> id left
    | otherwise     -> id right


define display-width-scalars :: [Int] -> Int -> Int -> Int -> Int -> Int -> Int
  scalars committed cluster previous regional-run previous-joiner
    | null? scalars -> committed + cluster
    | previous < 0 -> display-width-scalars (drop 1 scalars) committed (scalar-width (nth scalars 0)) (nth scalars 0) (next-regional-run (nth scalars 0) 0) (joiner-code (nth scalars 0))
    | grapheme-no-break? previous (nth scalars 0) regional-run previous-joiner -> display-width-scalars (drop 1 scalars) committed (maximum cluster (scalar-width (nth scalars 0))) (nth scalars 0) (next-regional-run (nth scalars 0) regional-run) (joiner-code (nth scalars 0))
    | otherwise -> display-width-scalars (drop 1 scalars) (committed + cluster) (scalar-width (nth scalars 0)) (nth scalars 0) (next-regional-run (nth scalars 0) 0) (joiner-code (nth scalars 0))


define display-width :: String -> Int
  text -> display-width-scalars (decode-utf8 text) 0 0 -1 0 0


;; Compatibility name retained for existing renderers.  Its meaning is now
;; unambiguously terminal display columns, not scalar count.
define text-width :: String -> Int
  text -> display-width text


tests
  :version:
  assert-eq unicode-version "17.0.0" "Unicode data version is pinned"
  :version:

  :scalars:
  assert-eq (valid-scalar? 0)        True  "U+0000 is a scalar value"
  assert-eq (valid-scalar? 0x10ffff) True  "U+10FFFF is a scalar value"
  assert-eq (valid-scalar? 0xd800)   False "high surrogate is not a scalar value"
  assert-eq (valid-scalar? 0xdfff)   False "low surrogate is not a scalar value"
  assert-eq (valid-scalar? 0x110000) False "values above Unicode are rejected"
  :scalars:

  :utf8:
  assert-eq (byte-count "Aλ🙂") 7 "UTF-8 byte count is explicit"
  assert-eq (valid-utf8? "Aλ🙂") True "valid mixed-width UTF-8"
  assert-eq (show (decode-utf8 "Aλ🙂")) "(65 955 128578)" "decode UTF-8 scalars"
  assert-eq (scalar-count "Aλ🙂") 3 "scalar count differs from byte count"
  assert-eq (encode-scalar 0x03bb) "λ" "UTF-8 encodes a two-byte scalar"
  assert-eq (encode-scalar 0x1f642) "🙂" "UTF-8 encodes a supplementary scalar"
  assert-eq (scalars->text ⌜0x41 0x03bb 0x1f642⌝) "Aλ🙂" "scalar sequences encode as text"
  assert-eq (valid-utf8? (bytes-prefix->text 2 (list 0xc0 0x80))) False "overlong UTF-8 is rejected"
  assert-eq (valid-utf8? (bytes-prefix->text 2 (list 0xe2 0x82))) False "truncated UTF-8 is rejected"
  assert-eq (valid-utf8? (bytes-prefix->text 1 (list 0x80))) False "stray continuation byte is rejected"
  assert-eq (unicode-scalar-value replacement-scalar) 0xfffd "replacement scalar is validated once"
  assert-eq (right? (unicode-scalar 0x1f642)) True "valid integers construct opaque UnicodeScalar values"
  assert-eq (left? (unicode-scalar 0xd800)) True "surrogates cannot construct UnicodeScalar values"
  assert-eq (right? (encode-scalar-result 0x03bb)) True "result encoder preserves successful validation"
  assert-eq (left? (encode-scalar-result 0x110000)) True "result encoder reports invalid scalars instead of replacing them"
  assert-eq (right? (decode-utf8-scalars-result "Aλ🙂")) True "typed UTF-8 decoding returns validated scalar values"
  assert-eq (left? (decode-utf8-scalars-result (bytes-prefix->text 1 (list 0x80)))) True "typed UTF-8 decoding reports malformed input"
  assert-eq (right? (scalars->text-result ⌜0x41 0x03bb 0x1f642⌝)) True "result text encoding validates every scalar"
  assert-eq (left? (scalars->text-result ⌜0x41 0xd800⌝)) True "result text encoding stops at an invalid scalar"
  :utf8:

  :segmentation:
  assert-eq (grapheme-count "abc") 3 "ASCII grapheme clusters"
  assert-eq (grapheme-count "é") 1 "combining sequence is one grapheme"
  assert-eq (grapheme-count "👩‍💻") 1 "emoji ZWJ sequence is one grapheme"
  assert-eq (grapheme-count "\r\n") 1 "GB3 keeps CR and LF in one cluster"
  assert-eq (grapheme-count "🇺🇸") 1 "GB12 and GB13 pair two regional indicators"
  assert-eq (grapheme-count "🇺🇸🇮") 2 "a third regional indicator starts a new cluster"
  assert-eq (grapheme-count "가") 1 "GB6 and GB7 join decomposed Hangul L and V"
  assert-eq (grapheme-count "각") 1 "GB6 through GB8 join decomposed Hangul L V T"
  :segmentation:

  :width:
  assert-eq (display-width "abc") 3 "ASCII terminal width"
  assert-eq (display-width "é") 1 "combining mark has zero added width"
  assert-eq (display-width "界") 2 "East Asian wide scalar uses two columns"
  assert-eq (display-width "👩‍💻") 2 "emoji ZWJ cluster uses two columns"
  assert-eq (display-width "🇺🇸") 2 "regional-indicator flag pair occupies two columns"
  assert-eq (display-width "각") 2 "decomposed Hangul cluster occupies two columns"
  assert-eq (text-width "∀x. □Fx") 7 "compatibility width delegates to display width"
  :width:
